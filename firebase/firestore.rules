rules_version = '2';

// 工班費用管理系統的 Firestore 安全規則。
//
// 重要：下面這個 UID 必須與 src/lib/firebase.ts 的 ADMIN_UIDS 完全一致。
// 要新增管理員時，把 UID 加進這裡的清單，並重新部署規則：
//   firebase deploy --only firestore:rules
//
// 師傅端（免登入連結）完全透過 Cloud Functions 以 Admin SDK 存取資料，
// 不受這裡的規則限制，因此師傅拿不到任何師傅名單或權杖。

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'XvUjeixONwOgLzKdtJ7AEueeIDq2';
    }

    match /technicians/{docId} {
      allow read, write: if isAdmin();
    }

    match /regions/{docId} {
      allow read, write: if isAdmin();
    }

    match /items/{docId} {
      allow read, write: if isAdmin();
    }

    match /technician_prices/{docId} {
      allow read, write: if isAdmin();
    }

    match /technician_fuel_fees/{docId} {
      allow read, write: if isAdmin();
    }

    match /jobs/{docId} {
      allow read, write: if isAdmin();
    }

    match /extra_claims/{docId} {
      allow read, write: if isAdmin();
    }

    // 其他路徑一律拒絕。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
